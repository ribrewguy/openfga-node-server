{
  "name": "openfga-node-server",
  "version": "0.1.0",
  "private": true,
  "description": "OpenFGA-wire-compatible authorization server in Node. Drop-in for the OpenFGA reference (Go) server for the surface this project implements.",
  "type": "module",
  "main": "dist/server.mjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.mjs",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration-pg": "vitest run --project integration-pg",
    "coverage": "vitest run --project unit --project integration --coverage",
    "coverage:unit": "vitest run --project unit --coverage --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.lines=0",
    "verify:fast": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm coverage",
    "load-model": "tsx src/cli/load-model.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "cert:create": "node scripts/setup-tls.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@hono/zod-validator": "^0.7.6",
    "@openfga/syntax-transformer": "^0.2.1",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "hono": "^4.6.14",
    "kysely": "^0.28.17",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openfga/sdk": "^0.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.21.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}