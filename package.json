{
  "name": "openfga-node-server",
  "version": "0.1.0",
  "private": true,
  "description": "OpenFGA-wire-compatible authorization server in Node. Drop-in for the OpenFGA reference (Go) server for the surface this project implements.",
  "type": "module",
  "main": "dist/server.mjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.mjs",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration-pg": "vitest run --project integration-pg",
    "coverage": "vitest run --project unit --project integration --coverage",
    "coverage:unit": "vitest run --project unit --coverage --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.lines=0",
    "verify:fast": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm coverage",
    "load-model": "tsx src/cli/load-model.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "cert:create": "node scripts/setup-tls.mjs",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@hono/otel": "^1.1.2",
    "@hono/zod-validator": "^0.7.6",
    "@openfga/syntax-transformer": "^0.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "better-sqlite3": "^12.10.0",
    "c12": "^3.3.4",
    "hono": "^4.6.14",
    "jose": "^6.2.3",
    "kysely": "^0.28.17",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openfga/sdk": "^0.9.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.22.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}