{
  "name": "openfga-node-server",
  "version": "0.1.0",
  "private": true,
  "description": "OpenFGA-wire-compatible authorization server in Node. Drop-in for the OpenFGA reference (Go) server for the surface this project implements.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "load-model": "tsx src/cli/load-model.ts",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -d OPENFGA_DB_URL --migrations-schema openfga --create-migrations-schema",
    "cert:create": "node scripts/setup-tls.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@openfga/syntax-transformer": "^0.2.1",
    "dotenv": "^17.4.2",
    "hono": "^4.6.14",
    "pg": "^8.20.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@openfga/sdk": "^0.9.4",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^8.0.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}