# ───────────────────────────────────────────────────────────────────
# OpenFGA-Node-Server — environment variables
# ───────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` and fill in values for your environment.
# `.env` is git-ignored and is loaded automatically by:
#   - `pnpm dev` / `pnpm start` (via `import 'dotenv/config'` in src/index.ts)
#   - `pnpm migrate` (via Node's `--env-file-if-exists=.env` flag)
#   - `pnpm load-model` (inherits the shell env; export or use `tsx --env-file=`)
#
# Naming convention:
#   OPENFGA_*       Server / runtime / CLI config
#   OPENFGA_DB_*    Postgres connection + pool tuning
#
# Each variable is marked REQUIRED or OPTIONAL with its default and
# the surface that reads it.

# ═══ Server runtime ════════════════════════════════════════════════

# REQUIRED — read by: server, migrate, integration tests
#
# Postgres DSN. Must point at a database where the `openfga` schema
# can live (or already lives). The server connects as a service-role /
# superuser to bypass RLS — other applications sharing the same
# Postgres instance must use a different role.
#
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME[?sslmode=require]
#
# Examples:
#   postgresql://postgres:postgres@localhost:5432/openfga
#   postgresql://app:secret@db.internal:5432/authz?sslmode=require
OPENFGA_DB_URL=

# OPTIONAL — read by: server. Default: 8080
#
# Port the server listens on. Used for both HTTP and HTTPS.
PORT=8080

# OPTIONAL — read by: server. Default: info
#
# Log verbosity. One of: trace, debug, info, warn, error, fatal, silent.
# Set to `debug` to see the per-request `request_start` event in detail
# (useful when diagnosing hangs — by default it's info-level too, just
# without per-handler internals).
#
# Output format auto-detects: human-readable + colored when stdout is
# a TTY (e.g. `pnpm dev` in your terminal), raw JSON otherwise (piped
# to a file, container stdout, CI). pino-pretty is only loaded in TTY
# mode — production deployments stream JSON with no extra cost.
OPENFGA_LOG_LEVEL=info

# ═══ TLS / HTTPS ═══════════════════════════════════════════════════
#
# Both REQUIRED to enable HTTPS, or both unset for HTTP.
# For local dev, generate trusted certs with:
#
#   pnpm cert:create
#
# That command uses mkcert to install a local root CA and issues a
# cert for `localhost`, `127.0.0.1`, and `::1` into `.certs/`. It
# prints the exact env-var values to paste here.
#
# In production, point these at your platform-managed cert paths
# (or terminate TLS upstream and leave both unset).
#
# Default: unset (HTTP)
OPENFGA_TLS_CERT_FILE=
OPENFGA_TLS_KEY_FILE=

# OPTIONAL — Node-side trust store augmentation.
#
# Set when OPENFGA_TLS_* are configured AND something inside Node
# (the load-model CLI, integration tests over HTTPS, etc.) needs to
# trust the cert. mkcert installs its root CA into the system trust
# store, but Node uses its own bundled CA list by default — this var
# bridges the two. `pnpm cert:create` prints the exact path.
#
# Example:
#   NODE_EXTRA_CA_CERTS=/Users/you/Library/Application Support/mkcert/rootCA.pem
NODE_EXTRA_CA_CERTS=

# ═══ Postgres connection pool ══════════════════════════════════════
#
# All variables in this section are OPTIONAL. Defaults are
# conservative and suitable for low-traffic deployments. Tune them up
# under sustained load; tune them down if your DB has tight
# connection limits (e.g., shared Postgres on a small plan).

# Identifies this process in `pg_stat_activity`. Useful when multiple
# services share the same DB.
# Default: openfga-node-server
OPENFGA_DB_APPLICATION_NAME=openfga-node-server

# Maximum simultaneous connections in the pool.
# Default: 10
OPENFGA_DB_POOL_MAX=10

# Minimum idle connections kept warm.
# Default: 0
OPENFGA_DB_POOL_MIN=0

# Idle connections are closed after this many milliseconds.
# Default: 30000 (30 seconds)
OPENFGA_DB_POOL_IDLE_TIMEOUT_MS=30000

# How long to wait when acquiring a new connection before giving up.
# Set to 0 (or leave unset) to wait forever. ms.
# Default: 0 (disabled)
# Production recommendation: 5000.
OPENFGA_DB_POOL_CONNECTION_TIMEOUT_MS=0

# Server-side statement timeout. Postgres aborts any single statement
# that runs longer than this. ms.
# Default: 0 (disabled)
# Production recommendation: 30000 — defensive cap against runaway
# evaluator queries on pathological models.
OPENFGA_DB_STATEMENT_TIMEOUT_MS=0

# Client-side query timeout (enforced by `pg` from the Node side).
# Independent of statement_timeout — one terminates from the DB; the
# other terminates from the client. ms.
# Default: 0 (disabled)
OPENFGA_DB_QUERY_TIMEOUT_MS=0

# ═══ Idempotency keys ══════════════════════════════════════════════
#
# Read by the server's idempotency middleware. The middleware applies
# only to the mutating endpoints in scope:
#
#   POST /stores
#   POST /stores/:storeId/authorization-models
#   POST /stores/:storeId/write
#
# Idempotency state lives in the openfga schema as
# `openfga.idempotency_keys`. When migrating to upstream OpenFGA, run
# the dump with:
#
#   pg_dump --schema=openfga \
#           --exclude-table='openfga.idempotency_keys'
#
# so the dump only carries OpenFGA-compatible state. See
# docs/PRD.md §"Idempotency keys" and
# docs/features/idemnpotency-keys.md for the full design.

# OPTIONAL — Default: off
#
# Idempotency rollout mode. One of:
#   - off      Middleware is a no-op. Existing clients are unaffected.
#   - optional Idempotency-Key is honored when present, ignored when absent.
#   - required Scoped mutating requests must include Idempotency-Key;
#              missing keys return 400.
OPENFGA_IDEMPOTENCY_MODE=off

# OPTIONAL — Default: 86400000 (24 hours, in milliseconds)
#
# Idempotency record retention. Replays are honored within this window;
# expired rows are deleted on the next claim attempt for the same key.
OPENFGA_IDEMPOTENCY_TTL_MS=86400000

# ═══ load-model CLI ════════════════════════════════════════════════
#
# Read by `pnpm load-model <path-to-model.fga>`. Not used by the
# server itself.

# OPTIONAL — Default: http://localhost:8080
#
# Base URL of the running server that load-model talks to. Override
# when the server is bound to a non-default host/port, running in
# another environment, or serving HTTPS.
#
# When the server is on HTTPS via mkcert, set this to
# `https://localhost:8080` AND ensure `NODE_EXTRA_CA_CERTS` points at
# the mkcert root CA so the CLI's fetch trusts the cert.
OPENFGA_API_URL=http://localhost:8080

# OPTIONAL — Default: (unset)
#
# Existing store id to load the model into. If unset, load-model
# creates a new store and prints the id.
OPENFGA_STORE_ID=

# OPTIONAL — Default: default
#
# Name to give the new store created by load-model when no
# OPENFGA_STORE_ID is provided.
OPENFGA_STORE_NAME=default
