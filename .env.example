# ───────────────────────────────────────────────────────────────────
# OpenFGA-Node-Server — environment variables
# ───────────────────────────────────────────────────────────────────
#
# This file is the env-var override surface. The canonical
# configuration source is `openfga.config.yaml` (or .yml/.toml/.json
# variants), discovered by c12 in CWD at startup. See
# `openfga.config.example.yaml` for the hierarchical schema, per-
# environment override blocks (`$development`/`$production`/`$test`),
# and the full env-var-to-config-path mapping reference. Every
# variable below corresponds to a nested field in the config file;
# setting one here overrides the file value at startup. See
# docs/features/configuration.md for the precedence order.
#
# Copy this file to `.env` and fill in values for your environment.
# `.env` is git-ignored and is loaded automatically at startup by
# c12's native env-file support (configured via `dotenv: true` on
# `loadConfig`). The previous `dotenv` runtime dependency is no
# longer required.
#
# Naming convention:
#   OPENFGA_*       Server / runtime / CLI config
#   OPENFGA_DB_*    Database connection + namespace + pool tuning
#
# Each variable is marked REQUIRED or OPTIONAL with its default and
# the surface that reads it.

# ═══ Server runtime ════════════════════════════════════════════════

# REQUIRED — read by: server, migrate, integration tests
#
# Database connection string. The dialect is inferred from the
# scheme:
#
#   postgres://… | postgresql://…  →  Postgres (production-recommended)
#   sqlite:…  | file:…  | :memory: →  SQLite (test backend, embedded use)
#
# Postgres notes — the server connects as a service-role / superuser
# to bypass RLS; other applications sharing the same Postgres instance
# must use a different role. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME[?sslmode=require]
#
# SQLite notes — single-process / single-writer model. Suitable for
# tests and embedded deployments, NOT for multi-instance production.
# RLS is unavailable; the pg_dump --schema=openfga migration-to-
# upstream-OpenFGA path is unavailable.
#
# Examples:
#   postgresql://postgres:postgres@localhost:5432/openfga
#   postgresql://app:secret@db.internal:5432/authz?sslmode=require
#   sqlite:./openfga.db
#   :memory:
OPENFGA_DB_URL=

# OPTIONAL — read by: server, migrate
#
# Namespace under which every table this server owns lives. Validated
# against /^[a-z][a-z0-9_]{0,62}$/ so it is a safe SQL identifier
# without quoting. Applied as:
#
#   Postgres → schema name (CREATE SCHEMA <namespace>; tables emit
#              as <namespace>.store, <namespace>.tuple, etc.)
#   SQLite   → table-name prefix joined by underscore (tables emit
#              as <namespace>_store, <namespace>_tuple, etc.)
#
# The same value covers OpenFGA-contract tables, operational tables
# (idempotency_keys, tuple_change, assertions), and the Kysely
# Migrator's tracking tables (kysely_migration, kysely_migration_lock).
# No table escapes the namespace.
#
# The pg_dump --schema=<namespace> migration-to-upstream-OpenFGA
# recipe in the README must be substituted with the configured value
# when this is non-default.
#
# Default: openfga
OPENFGA_DB_NAMESPACE=openfga

# OPTIONAL — read by: server (NOT migrate, NOT serverless `index.ts`).
#
# When set to `true`, the self-host bootstrap awaits
# `migrator.migrateToLatest()` against `OPENFGA_DB_URL` BEFORE binding
# any TCP listener. Failure is fatal — the server refuses to start
# rather than accept traffic against a half-migrated database.
#
# Off by default. Operators using a managed deploy step (the documented
# `pnpm migrate up` invocation in CI / a release job) should leave it
# off. Turn it on when the deployment shape is "container that should
# self-bootstrap its schema on first start" (single-instance, embedded
# SQLite, dev/preview environments).
#
# WARNING — multi-instance and serverless deployments: the Migrator
# advisory lock (`<ns>.kysely_migration_lock`) correctly serializes
# concurrent runs, so the schema cannot be corrupted. But every
# concurrent boot still queues on the lock, ballooning startup latency
# on the request-serving path. Prefer an explicit deploy step in those
# topologies.
#
# Strict parser: only the literal strings `true` or `false` are
# accepted (case- and whitespace-tolerant). Any other value is fatal.
#
# Default: false
OPENFGA_MIGRATE_ON_START=false

# ═══ Listeners ═════════════════════════════════════════════════════
#
# The server can run an HTTP listener, an HTTPS listener, or both.
# HTTP is on by default. HTTPS is on whenever the TLS env vars below
# (OPENFGA_TLS_CERT_FILE + OPENFGA_TLS_KEY_FILE) are both set.
#
# At least one listener must be active — disabling HTTP without TLS
# certs is a fatal misconfiguration and the server refuses to start.
#
# Note: in earlier versions a single `PORT` env var picked the port
# for whichever protocol was active. `PORT` is no longer read; replace
# it with `OPENFGA_HTTP_PORT` and/or `OPENFGA_HTTPS_PORT`. If you were
# relying on `PORT=X + certs` to serve HTTPS-only on port X, set
# `OPENFGA_HTTP_ENABLED=false` and `OPENFGA_HTTPS_PORT=X`.

# OPTIONAL — read by: server. Default: 8080
#
# Port for the plain-HTTP listener.
OPENFGA_HTTP_PORT=8080

# OPTIONAL — read by: server. Default: 8443
#
# Port for the HTTPS listener. Only used when the TLS env vars are
# set. Defaults to the unprivileged 8443 so `pnpm dev` and `pnpm start`
# work without sudo. In production, set this to 443 (and run as a user
# with CAP_NET_BIND_SERVICE) or terminate TLS upstream.
OPENFGA_HTTPS_PORT=8443

# OPTIONAL — read by: server. Default: true
#
# Set to `false` to disable the HTTP listener entirely. Requires the
# TLS env vars to be set; otherwise the server has no listener and
# refuses to start. Use this for HTTPS-only deployments.
OPENFGA_HTTP_ENABLED=true

# OPTIONAL — read by: server. Default: info
#
# Log verbosity. One of: trace, debug, info, warn, error, fatal, silent.
# Set to `debug` to see the per-request `request_start` event in detail
# (useful when diagnosing hangs — by default it's info-level too, just
# without per-handler internals).
#
# Output format auto-detects: human-readable + colored when stdout is
# a TTY (e.g. `pnpm dev` in your terminal), raw JSON otherwise (piped
# to a file, container stdout, CI). pino-pretty is only loaded in TTY
# mode — production deployments stream JSON with no extra cost.
OPENFGA_LOG_LEVEL=info

# ═══ TLS / HTTPS ═══════════════════════════════════════════════════
#
# Both REQUIRED to enable HTTPS, or both unset for HTTP-only.
# When set, an HTTPS listener is started on OPENFGA_HTTPS_PORT
# (default 8443) in addition to the HTTP listener.
# For local dev, generate trusted certs with:
#
#   pnpm cert:create
#
# That command uses mkcert to install a local root CA and issues a
# cert for `localhost`, `127.0.0.1`, and `::1` into `.certs/`. It
# prints the exact env-var values to paste here.
#
# In production, point these at your platform-managed cert paths
# (or terminate TLS upstream and leave both unset).
#
# Default: unset (HTTP)
OPENFGA_TLS_CERT_FILE=
OPENFGA_TLS_KEY_FILE=

# OPTIONAL — Node-side trust store augmentation.
#
# Set when OPENFGA_TLS_* are configured AND something inside Node
# (the load-model CLI, integration tests over HTTPS, etc.) needs to
# trust the cert. mkcert installs its root CA into the system trust
# store, but Node uses its own bundled CA list by default — this var
# bridges the two. `pnpm cert:create` prints the exact path.
#
# Example:
#   NODE_EXTRA_CA_CERTS=/Users/you/Library/Application Support/mkcert/rootCA.pem
NODE_EXTRA_CA_CERTS=

# ═══ Caller authentication ═════════════════════════════════════════
#
# The server mirrors the OpenFGA reference server's `--authn-method`
# surface so existing OpenFGA SDK clients port over without code
# changes. Auth applies to all /stores/* endpoints; /health is
# always reachable without credentials for liveness probes.

# OPTIONAL — read by: server. Default: none
#
# Authentication mode. One of:
#   - none      No auth check; any caller may hit /stores/* endpoints.
#   - preshared Bearer-token auth. Requests must carry
#               `Authorization: Bearer <key>` whose value matches one
#               of OPENFGA_AUTH_PRESHARED_KEYS. Comparison is
#               constant-time.
# OIDC mode is tracked separately and is not yet implemented.
OPENFGA_AUTH_MODE=none

# REQUIRED when OPENFGA_AUTH_MODE=preshared.
#
# Comma-separated list of accepted preshared keys. Multiple keys are
# supported for zero-downtime rotation: deploy with both old and new
# keys, rotate clients, then redeploy without the old key.
#
# The server fails fast at startup if mode is `preshared` and this
# variable is empty.
#
# Example:
#   OPENFGA_AUTH_PRESHARED_KEYS=k_old_abc123,k_new_def456
OPENFGA_AUTH_PRESHARED_KEYS=

# ═══ OIDC auth (when OPENFGA_AUTH_MODE=oidc) ═══════════════════════
#
# JWT/OIDC bearer-token authentication. Validates the Authorization
# header against the configured issuer's published JWKS. See
# docs/features/oidc-auth.md for the full contract.

# REQUIRED when OPENFGA_AUTH_MODE=oidc.
#
# The issuer URL whose .well-known/openid-configuration document the
# server fetches at boot to resolve jwks_uri. Tokens are validated
# against this issuer (and any aliases below) for the iss claim.
OPENFGA_AUTH_OIDC_ISSUER=

# REQUIRED when OPENFGA_AUTH_MODE=oidc.
#
# Audience the server expects in the token's aud claim. Typically
# the API's logical name or URI.
OPENFGA_AUTH_OIDC_AUDIENCE=

# OPTIONAL — comma-separated alternative iss values accepted in
# addition to OPENFGA_AUTH_OIDC_ISSUER. Useful for federated IdPs
# whose token iss claim doesn't exactly match the discovery URL.
OPENFGA_AUTH_OIDC_ISSUER_ALIASES=

# OPTIONAL — comma-separated subject allowlist. When set, only
# tokens whose sub claim is in this list are accepted. Empty =
# accept any sub.
OPENFGA_AUTH_OIDC_SUBJECTS=

# OPTIONAL — comma-separated client_id/azp allowlist.
OPENFGA_AUTH_OIDC_CLIENTS=

# OPTIONAL — comma-separated allowed signing algorithms. Default:
# the full asymmetric set (RS*, ES*, PS*, EdDSA). HS* (HMAC) values
# are explicitly rejected at config load.
OPENFGA_AUTH_OIDC_ALGORITHMS=

# OPTIONAL — clock skew tolerance for exp/nbf claims, in seconds.
# Default: 60.
OPENFGA_AUTH_OIDC_CLOCK_SKEW_SEC=

# OPTIONAL — direct JWKS URI, overriding OIDC discovery. When set,
# the server skips the .well-known/openid-configuration fetch.
OPENFGA_AUTH_OIDC_JWKS_URI=

# ═══ Postgres connection pool ══════════════════════════════════════
#
# All variables in this section are OPTIONAL. Defaults are
# conservative and suitable for low-traffic deployments. Tune them up
# under sustained load; tune them down if your DB has tight
# connection limits (e.g., shared Postgres on a small plan).

# Identifies this process in `pg_stat_activity`. Useful when multiple
# services share the same DB.
# Default: openfga-node-server
OPENFGA_DB_APPLICATION_NAME=openfga-node-server

# Maximum simultaneous connections in the pool.
# Default: 10
OPENFGA_DB_POOL_MAX=10

# Minimum idle connections kept warm.
# Default: 0
OPENFGA_DB_POOL_MIN=0

# Idle connections are closed after this many milliseconds.
# Default: 30000 (30 seconds)
OPENFGA_DB_POOL_IDLE_TIMEOUT_MS=30000

# How long to wait when acquiring a new connection before giving up.
# Set to 0 (or leave unset) to wait forever. ms.
# Default: 0 (disabled)
# Production recommendation: 5000.
OPENFGA_DB_POOL_CONNECTION_TIMEOUT_MS=0

# Server-side statement timeout. Postgres aborts any single statement
# that runs longer than this. ms.
# Default: 0 (disabled)
# Production recommendation: 30000 — defensive cap against runaway
# evaluator queries on pathological models.
OPENFGA_DB_STATEMENT_TIMEOUT_MS=0

# Client-side query timeout (enforced by `pg` from the Node side).
# Independent of statement_timeout — one terminates from the DB; the
# other terminates from the client. ms.
# Default: 0 (disabled)
OPENFGA_DB_QUERY_TIMEOUT_MS=0

# ═══ Idempotency keys ══════════════════════════════════════════════
#
# Read by the server's idempotency middleware. The middleware applies
# only to the mutating endpoints in scope:
#
#   POST /stores
#   POST /stores/:storeId/authorization-models
#   POST /stores/:storeId/write
#
# Idempotency state lives in the openfga schema as
# `openfga.idempotency_keys`. When migrating to upstream OpenFGA, run
# the dump with:
#
#   pg_dump --schema=openfga \
#           --exclude-table='openfga.idempotency_keys'
#
# so the dump only carries OpenFGA-compatible state. See
# docs/PRD.md §"Idempotency keys" and
# docs/features/idemnpotency-keys.md for the full design.

# OPTIONAL — Default: off
#
# Idempotency rollout mode. One of:
#   - off      Middleware is a no-op. Existing clients are unaffected.
#   - optional Idempotency-Key is honored when present, ignored when absent.
#   - required Scoped mutating requests must include Idempotency-Key;
#              missing keys return 400.
OPENFGA_IDEMPOTENCY_MODE=off

# OPTIONAL — Default: 86400000 (24 hours, in milliseconds)
#
# Idempotency record retention. Replays are honored within this window;
# expired rows are deleted on the next claim attempt for the same key.
OPENFGA_IDEMPOTENCY_TTL_MS=86400000

# ═══ load-model CLI ════════════════════════════════════════════════
#
# Read by `pnpm load-model <path-to-model.fga>`. Not used by the
# server itself.

# OPTIONAL — Default: http://localhost:8080
#
# Base URL of the running server that load-model talks to. Override
# when the server is bound to a non-default host/port, running in
# another environment, or serving HTTPS.
#
# When the server is on HTTPS via mkcert, set this to
# `https://localhost:8443` (the default OPENFGA_HTTPS_PORT) AND ensure
# `NODE_EXTRA_CA_CERTS` points at the mkcert root CA so the CLI's
# fetch trusts the cert.
OPENFGA_API_URL=http://localhost:8080

# OPTIONAL — Default: (unset)
#
# Existing store id to load the model into. If unset, load-model
# creates a new store and prints the id.
OPENFGA_STORE_ID=

# OPTIONAL — Default: default
#
# Name to give the new store created by load-model when no
# OPENFGA_STORE_ID is provided.
OPENFGA_STORE_NAME=default

# ═══ OpenTelemetry ═════════════════════════════════════════════════
#
# Off by default. When OPENFGA_OTEL_ENABLED=true the SDK is
# initialized at boot before listeners bind and spans are emitted at
# every instrumented boundary. See docs/features/opentelemetry.md for
# the full span catalog and per-boundary semantics.

# Master switch. Default: false. When false, the SDK is never
# imported and zero spans are emitted.
OPENFGA_OTEL_ENABLED=false

# OPTIONAL — Service identity reported as resource attributes.
# Defaults: openfga-node-server, package.json version.
OPENFGA_OTEL_SERVICE_NAME=openfga-node-server
OPENFGA_OTEL_SERVICE_VERSION=

# OPTIONAL — Exporter. Default type: otlp-http.
# type: otlp-http | otlp-grpc | console | none
# endpoint also honors OTEL_EXPORTER_OTLP_ENDPOINT / _TRACES_ENDPOINT.
OPENFGA_OTEL_EXPORTER_TYPE=otlp-http
OPENFGA_OTEL_EXPORTER_ENDPOINT=
OPENFGA_OTEL_EXPORTER_TIMEOUT_MS=10000

# OPTIONAL — Comma-separated propagators. Default: tracecontext,baggage.
# Other supported names require the corresponding @opentelemetry/
# propagator-* package and a buildPropagator() entry in
# src/observability/otel.ts.
OPENFGA_OTEL_PROPAGATORS=

# OPTIONAL — Sampler.
# type: always_on (default) | always_off | parentbased_always_on |
#       traceidratio | parentbased_traceidratio
# ratio used by ratio-based samplers (0.0-1.0).
OPENFGA_OTEL_SAMPLER_TYPE=always_on
OPENFGA_OTEL_SAMPLER_RATIO=1.0

# OPTIONAL — Captured HTTP headers (comma-separated).
# Sensitive headers (authorization, cookie, x-api-key,
# idempotency-key, ...) are rejected at config-load.
OPENFGA_OTEL_CAPTURE_REQUEST_HEADERS=traceparent,tracestate,baggage
OPENFGA_OTEL_CAPTURE_RESPONSE_HEADERS=

# OPTIONAL — Per-boundary span gates. Each defaults to true when
# OPENFGA_OTEL_ENABLED=true. Set to false to suppress a category.
OPENFGA_OTEL_SPANS_HTTP=true
OPENFGA_OTEL_SPANS_EVALUATOR=true
OPENFGA_OTEL_SPANS_STORAGE=true
OPENFGA_OTEL_SPANS_AUTH=true
OPENFGA_OTEL_SPANS_IDEMPOTENCY=true
